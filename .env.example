# Mogic-Studio deployment environment
# Docker: copy this file to .env in the repository root.
# Source development: copy it to web/.env.local and change DATABASE_URL host to localhost.

# Required public URL. Production should use the externally reachable HTTPS origin without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional image override. The default Compose release is pinned; use mogic-studio:local when building on the server.
MOGIC_STUDIO_IMAGE=ghcr.io/csyqlz/mogic-studio:v0.0.6

# Default Docker Compose creates this PostgreSQL database and overrides DATABASE_URL with host `postgres`.
POSTGRES_DB=mogic_studio
POSTGRES_USER=mogic_studio
POSTGRES_PASSWORD=

# Source deployment and external PostgreSQL connection.
MOGIC_STUDIO_DATABASE_PROVIDER=postgres
DATABASE_URL=
MOGIC_STUDIO_DATABASE_POOL_MAX=10
# Local/Docker PostgreSQL normally uses 0. Managed cloud PostgreSQL commonly requires 1.
MOGIC_STUDIO_DATABASE_SSL=0
# TLS verification defaults to enabled. Only set 0 for a provider that cannot supply a trusted certificate.
MOGIC_STUDIO_DATABASE_SSL_REJECT_UNAUTHORIZED=1
# Optional PEM CA certificate. In single-line env files encode line breaks as \n.
MOGIC_STUDIO_DATABASE_SSL_CA=

# Required in production. Must be 64 hexadecimal characters or exact 32-byte Base64.
# Generate once with `openssl rand -hex 32`, keep it stable, and never commit the real value.
MOGIC_STUDIO_ENCRYPTION_KEY=

# Required only until the first administrator is created. Use at least 32 random characters.
# Generate with `openssl rand -hex 32`; keep it server-side and remove it after installation completes.
MOGIC_STUDIO_INSTALL_TOKEN=

# Runtime paths and internal callbacks.
MOGIC_STUDIO_DATA_DIR=/app/web/.data
MOGIC_STUDIO_INTERNAL_ORIGIN=http://127.0.0.1:3000
# Leave empty for automatic HTTP/HTTPS detection. Set true or false only for unusual proxies.
MOGIC_STUDIO_COOKIE_SECURE=
# Reverse proxy hop count used for rate limiting client IPs. Set 1 for one trusted proxy.
MOGIC_STUDIO_TRUSTED_PROXY_HOPS=0
# Optional local override when FFmpeg is not on PATH. Docker images already include FFmpeg.
FFMPEG_PATH=
FFPROBE_PATH=

# Optional outbound proxy used by server-side model/provider requests.
HTTPS_PROXY=
HTTP_PROXY=
ALL_PROXY=

# Private or loopback model providers are blocked by default. Enable only for administrator-controlled hosts.
# Hosts are exact, comma-separated names or IP addresses; do not add cloud metadata or link-local addresses.
MOGIC_STUDIO_ALLOW_PRIVATE_UPSTREAMS=0
MOGIC_STUDIO_PRIVATE_UPSTREAM_HOSTS=

# Billing behavior.
MOGIC_STUDIO_BILLING_ORDER_EXPIRES_MINUTES=30
# Optional token for deployment-neutral maintenance jobs. Use at least 32 random characters.
# Generate with `openssl rand -hex 32`, then call maintenance APIs with `Authorization: Bearer <token>`.
MOGIC_STUDIO_MAINTENANCE_TOKEN=
# Required by the generation Worker and internal per-user task callbacks. It must differ from the maintenance token.
MOGIC_STUDIO_WORKER_TOKEN=
# Worker polls the internal endpoint. Docker Compose sets this to http://app:3000.
MOGIC_STUDIO_WORKER_API_ORIGIN=
MOGIC_STUDIO_GENERATION_WORKER_ID=
# Initial idle polling interval. Consecutive empty batches back off to 10000ms.
MOGIC_STUDIO_GENERATION_WORKER_INTERVAL_MS=2000
MOGIC_STUDIO_GENERATION_WORKER_LANES=2
MOGIC_STUDIO_GENERATION_WORKER_HEARTBEAT_MS=15000
MOGIC_STUDIO_GENERATION_WORKER_STALE_MS=90000

# Optional work-publication moderation signal provider. Signals never auto-approve content.
# manual: always requires an administrator review (default).
# keywords: checks the comma/newline-separated keyword list below.
# http: POSTs public draft fields to the configured endpoint with a 3-second timeout.
MOGIC_STUDIO_CONTENT_MODERATION_PROVIDER=manual
MOGIC_STUDIO_CONTENT_MODERATION_KEYWORDS=
MOGIC_STUDIO_CONTENT_MODERATION_URL=
MOGIC_STUDIO_CONTENT_MODERATION_API_KEY=

# Optional Stripe configuration. It can also be saved from the admin payment settings page.
MOGIC_STUDIO_STRIPE_SECRET_KEY=
MOGIC_STUDIO_STRIPE_WEBHOOK_SECRET=
MOGIC_STUDIO_STRIPE_API_BASE=https://api.stripe.com
MOGIC_STUDIO_STRIPE_SUCCESS_URL=
MOGIC_STUDIO_STRIPE_CANCEL_URL=
MOGIC_STUDIO_STRIPE_PAYMENT_METHOD_TYPES=
MOGIC_STUDIO_STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# Optional Alipay configuration.
MOGIC_STUDIO_ALIPAY_MODE=official
MOGIC_STUDIO_ALIPAY_APP_ID=
MOGIC_STUDIO_ALIPAY_PRIVATE_KEY=
MOGIC_STUDIO_ALIPAY_PRIVATE_KEY_PATH=
MOGIC_STUDIO_ALIPAY_PUBLIC_KEY=
MOGIC_STUDIO_ALIPAY_PUBLIC_KEY_PATH=
MOGIC_STUDIO_ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
MOGIC_STUDIO_ALIPAY_NOTIFY_URL=
MOGIC_STUDIO_ALIPAY_RETURN_URL=

# Optional WeChat Pay v3 configuration.
MOGIC_STUDIO_WECHAT_PAY_APP_ID=
MOGIC_STUDIO_WECHAT_PAY_MCH_ID=
MOGIC_STUDIO_WECHAT_PAY_CERT_SERIAL_NO=
MOGIC_STUDIO_WECHAT_PAY_PRIVATE_KEY=
MOGIC_STUDIO_WECHAT_PAY_PRIVATE_KEY_PATH=
MOGIC_STUDIO_WECHAT_PAY_API_V3_KEY=
MOGIC_STUDIO_WECHAT_PAY_PLATFORM_CERT_SERIAL_NO=
MOGIC_STUDIO_WECHAT_PAY_PLATFORM_PUBLIC_KEY=
MOGIC_STUDIO_WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=
MOGIC_STUDIO_WECHAT_PAY_PLATFORM_CERTIFICATE=
MOGIC_STUDIO_WECHAT_PAY_PLATFORM_CERTIFICATE_PATH=
MOGIC_STUDIO_WECHAT_PAY_API_BASE=https://api.mch.weixin.qq.com
MOGIC_STUDIO_WECHAT_PAY_NOTIFY_URL=
MOGIC_STUDIO_WECHAT_PAY_REFUND_NOTIFY_URL=
MOGIC_STUDIO_WECHAT_PAY_WEBHOOK_TOLERANCE_SECONDS=300

# Optional PayPly/custom gateway configuration.
MOGIC_STUDIO_PAYPLY_CHECKOUT_URL=
MOGIC_STUDIO_PAYPLY_REFUND_URL=
MOGIC_STUDIO_PAYPLY_API_KEY=
MOGIC_STUDIO_PAYPLY_API_KEY_HEADER=
MOGIC_STUDIO_PAYPLY_MERCHANT_ID=
MOGIC_STUDIO_PAYPLY_REQUEST_METHOD=POST
MOGIC_STUDIO_PAYPLY_CONTENT_TYPE=application/json
MOGIC_STUDIO_PAYPLY_EXTRA_HEADERS=
MOGIC_STUDIO_PAYPLY_REQUEST_TEMPLATE=
MOGIC_STUDIO_PAYPLY_NOTIFY_URL=
MOGIC_STUDIO_PAYPLY_RETURN_URL=
MOGIC_STUDIO_PAYPLY_CANCEL_URL=
MOGIC_STUDIO_PAYPLY_RESULT_KIND=
MOGIC_STUDIO_PAYPLY_URL_FIELD=data.payUrl
MOGIC_STUDIO_PAYPLY_QR_FIELD=data.qrContent
MOGIC_STUDIO_PAYPLY_FORM_FIELD=data.formHtml
MOGIC_STUDIO_PAYPLY_PROVIDER_ORDER_ID_FIELD=data.tradeId
MOGIC_STUDIO_PAYPLY_PROVIDER_PAYMENT_ID_FIELD=data.paymentId
MOGIC_STUDIO_PAYPLY_WEBHOOK_SECRET=
MOGIC_STUDIO_PAYPLY_WEBHOOK_SIGNATURE_HEADER=x-signature
MOGIC_STUDIO_PAYPLY_WEBHOOK_EVENT_ID_FIELD=id
MOGIC_STUDIO_PAYPLY_WEBHOOK_EVENT_TYPE_FIELD=type
MOGIC_STUDIO_PAYPLY_WEBHOOK_ORDER_ID_FIELD=data.orderId
MOGIC_STUDIO_PAYPLY_WEBHOOK_ORDER_NO_FIELD=data.orderNo
MOGIC_STUDIO_PAYPLY_WEBHOOK_STATUS_FIELD=data.status
MOGIC_STUDIO_PAYPLY_WEBHOOK_SUCCESS_STATUSES=paid,success,succeeded,completed
MOGIC_STUDIO_PAYPLY_WEBHOOK_TRADE_ID_FIELD=data.tradeId
MOGIC_STUDIO_PAYPLY_WEBHOOK_PAYMENT_ID_FIELD=data.paymentId
MOGIC_STUDIO_PAYPLY_WEBHOOK_AMOUNT_CENTS_FIELD=data.amountCents
MOGIC_STUDIO_PAYPLY_WEBHOOK_AMOUNT_YUAN_FIELD=data.amount
MOGIC_STUDIO_PAYPLY_WEBHOOK_CURRENCY_FIELD=data.currency
MOGIC_STUDIO_PAYPLY_WEBHOOK_PAID_AT_FIELD=data.paidAt
MOGIC_STUDIO_PAYPLY_REFUND_REQUEST_METHOD=POST
MOGIC_STUDIO_PAYPLY_REFUND_CONTENT_TYPE=application/json
MOGIC_STUDIO_PAYPLY_REFUND_EXTRA_HEADERS=
MOGIC_STUDIO_PAYPLY_REFUND_REQUEST_TEMPLATE=
MOGIC_STUDIO_PAYPLY_REFUND_ID_FIELD=data.refundId
MOGIC_STUDIO_PAYPLY_REFUND_STATUS_FIELD=data.status
MOGIC_STUDIO_PAYPLY_REFUND_SUCCESS_STATUSES=refunded,success,succeeded

# Generic signed callback fallback for /api/billing/webhooks/custom.
MOGIC_STUDIO_PAYMENT_WEBHOOK_SECRET=
